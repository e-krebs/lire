# mock (default) uses the bundled fixtures; real targets the Worker at /api.
VITE_API_MODE=mock
# seed forces the synthetic fixtures even when fixtures/real/ exists (default: real when complete).
VITE_FIXTURES=
# Local fixture recording only.
NEWSBLUR_USERNAME=
NEWSBLUR_PASSWORD=

# Worker OAuth secrets (also configured in Cloudflare and GitHub).
NEWSBLUR_OAUTH_CLIENT_ID=
NEWSBLUR_OAUTH_CLIENT_SECRET=
