{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/client/routeTree.gen.ts!", "scripts/check-credits-libraries.ts!"],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "!src/test/**!",
    "!src/server/__tests__/cloudflare/**!",
    "!src/**/__stories__/**!",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": [
    "src/client/components/primitives/controls/Stepper.tsx",
    "src/client/components/primitives/controls/StepPanel.tsx",
    "src/client/hooks/useStepFocus.ts",
    "src/client/utils/steps.ts"
  ],
  "ignoreDependencies": ["cloudflare", "@vitest/expect"],
  "ignoreBinaries": ["vite"],
  "ignoreIssues": {
    "src/client/api/queries/index.ts": ["exports"],
    "src/client/api/queries/subscribe.ts": ["exports"]
  }
}
