{
  "name": "lire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lire — a personal feeds PWA reader",
  "scripts": {
    "dev": "vite dev --host --port 3000",
    "build": "vite build",
    "build:demo": "VITE_DEMO=true VITE_API_MODE=mock VITE_FIXTURES=seed vite build",
    "preview": "vite preview",
    "storybook": "storybook dev --port 6006",
    "build:storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "typecheck": "tsc --noEmit",
    "typecheck:sw": "tsc -p src/client/sw/tsconfig.json",
    "typecheck:worker": "tsc -p src/server/tsconfig.json",
    "typecheck:node": "tsc -p scripts/tsconfig.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "oxlint",
    "knip": "knip",
    "knip:production": "knip --production",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt .",
    "check:secrets": "node scripts/check-dist-secrets.ts",
    "check:demo": "node scripts/check-demo-brand.ts",
    "check:links": "node scripts/check-links.ts",
    "check:access": "node scripts/check-access.ts",
    "check:live": "node scripts/check-live.ts",
    "provision:pages": "node scripts/provision-pages.ts",
    "icons": "node scripts/render-icons.ts",
    "build:timezones": "node scripts/build-timezones.ts",
    "fixtures:record": "node scripts/record-fixtures.ts",
    "test": "vitest run --project client",
    "test:worker": "vitest run --project server",
    "test:coverage": "vitest run --project client --coverage --coverage.provider=v8 --coverage.include='src/client/**' --coverage.include='src/shared/**' --coverage.reportsDirectory=${COVERAGE_DIR:-coverage/client}",
    "test:worker:coverage": "vitest run --project server --coverage --coverage.provider=istanbul --coverage.include='src/server/**/*.ts' --coverage.reportsDirectory=${COVERAGE_DIR:-coverage/server}",
    "check:export-coverage": "node scripts/check-export-coverage.ts",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "E2E_COVERAGE=1 playwright test --project=desktop",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "deploy:spa": "VITE_API_MODE=real vite build && VITE_API_MODE=real yarn check:secrets && wrangler pages deploy dist --project-name lire --branch main",
    "deploy:storybook": "yarn build:storybook && yarn check:demo storybook-static && wrangler pages deploy storybook-static --project-name lire-storybook --branch main",
    "deploy:demo": "yarn build:demo && yarn check:demo && yarn check:secrets && wrangler pages deploy dist --project-name lire-demo --branch main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-krebs/lire.git"
  },
  "author": "Emmanuel Krebs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/e-krebs/lire/issues"
  },
  "homepage": "https://github.com/e-krebs/lire#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "dompurify": "^3.4.16",
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.41",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/expect": "5.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "miniflare": "4.20260730.0",
    "monocart-coverage-reports": "^2.13.0",
    "msw": "^2.15.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.3",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "wrangler": "^4.143.0"
  },
  "resolutions": {
    "sharp@npm:0.35.2": "npm:0.35.5",
    "undici@npm:7.28.0": "npm:7.30.0",
    "undici@npm:7.29.0": "npm:7.30.0"
  },
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=24"
  }
}
